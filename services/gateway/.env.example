# Secret-free end-to-end demo.
HELIX_MODE=mock
HELIX_HOST=127.0.0.1
HELIX_PORT=8787
HELIX_MOCK_TRANSCRIPT=What are the three most important next steps?

# Optional browser-to-gateway access token. The client sends this only as the
# helix-auth.<base64url> WebSocket subprotocol, never in session.start or a URL.
# HELIX_GATEWAY_TOKEN=

# Defaults are profile IDs. Clients may request only IDs in the allowlists.
# Built-in metadata may be allowlisted with no server key; a companion BYOK
# key can then bind that profile for one session. Environment keys are fallback.
HELIX_TRANSCRIPTION_PROVIDER=mock
HELIX_ANSWER_PROVIDER=mock
HELIX_ALLOWED_TRANSCRIPTION_PROFILES=mock
HELIX_ALLOWED_ANSWER_PROFILES=mock

# Optional administrator OpenAI fallback. The companion can instead send a
# session-only OpenAI key over WSS; it is never written by this server.
# HELIX_OPENAI_API_KEY=
# HELIX_OPENAI_BASE_URL=https://api.openai.com/v1
# HELIX_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# HELIX_OPENAI_RESPONSE_MODEL=gpt-4.1-mini

# Optional administrator Deepgram fallback.
# HELIX_DEEPGRAM_API_KEY=
# HELIX_DEEPGRAM_BASE_URL=https://api.deepgram.com
# HELIX_DEEPGRAM_MODEL=nova-3

# Optional administrator Soniox fallback.
# HELIX_SONIOX_API_KEY=
# HELIX_SONIOX_WEBSOCKET_URL=wss://stt-rt.soniox.com/transcribe-websocket
# HELIX_SONIOX_MODEL=stt-rt-v5

# Copy/paste preset for switching among every built-in profile in the G2 UI.
# Replace the two mock-only allowlists above with these values. Set fallback
# keys here or enter BYOK keys in the companion; never put keys in app.json,
# VITE_ variables, source, or the .ehpk.
# HELIX_OPENAI_API_KEY=replace-on-server
# HELIX_DEEPGRAM_API_KEY=replace-on-server
# HELIX_SONIOX_API_KEY=replace-on-server
# HELIX_ALLOWED_TRANSCRIPTION_PROFILES=mock,openai-compatible,deepgram,soniox
# HELIX_ALLOWED_ANSWER_PROFILES=mock,openai-responses,openai-compatible

# Named server profiles contain no keys. Each kind resolves its key from the
# dedicated server variable above. Add every client-selectable ID to its
# corresponding allowlist.
# HELIX_TRANSCRIPTION_PROFILES_JSON={"meeting-stt":{"kind":"deepgram","model":"nova-3"}}
# HELIX_ANSWER_PROFILES_JSON={"fast-answer":{"kind":"openai-responses","model":"gpt-4.1-mini"}}

# Custom OpenAI-compatible backend and legacy single-profile mode.
# HELIX_MODE=openai-compatible
# HELIX_PROVIDER_ID=openai-compatible
# HELIX_PROVIDER_BASE_URL=https://api.openai.com/v1
# HELIX_TRANSCRIPTION_PATH=/audio/transcriptions
# HELIX_CHAT_PATH=/chat/completions
# HELIX_API_KEY=
# HELIX_AUTH_HEADER=Authorization
# HELIX_AUTH_SCHEME=Bearer
# HELIX_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# HELIX_CHAT_MODEL=gpt-4o-mini
# HELIX_PROVIDER_HEADERS_JSON={"X-Organization":"example"}

# Optional Omi Developer API environment fallback. A session can also submit
# an Omi BYOK key. Writes always require the explicit server write flag.
# HELIX_OMI_API_KEY=
# HELIX_OMI_BASE_URL=https://api.omi.me
# HELIX_OMI_MEMORIES_PATH=/v1/dev/user/memories
# HELIX_OMI_MEMORY_CATEGORY=interesting
# HELIX_OMI_MAX_RECENT=25
# HELIX_OMI_MAX_CONTEXT_MEMORIES=5
# HELIX_OMI_MAX_CONTEXT_CHARACTERS=1500
# HELIX_OMI_TIMEOUT_MS=750
# HELIX_OMI_ANSWER_WAIT_MS=50
HELIX_OMI_WRITE_ENABLED=false

# Protected prompt boundary. Client prompt text is ignored unless explicitly
# allowed, and even then remains subordinate to this instruction.
HELIX_PROMPT_ID=helix-conversation
HELIX_PROMPT_VERSION=1
HELIX_SYSTEM_PROMPT=Answer the user's question directly and concisely. State uncertainty rather than inventing facts.
HELIX_ALLOW_CLIENT_PROMPT=false

HELIX_REQUEST_TIMEOUT_MS=120000
HELIX_MAX_AUDIO_BYTES=8388608
