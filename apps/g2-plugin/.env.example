# Optional development default shown in the gateway URL field.
# The production origin must also be present in app.json's network whitelist.
VITE_HELIX_GATEWAY_URL=ws://127.0.0.1:8787/v2/conversations

# Access tokens are deliberately not supported as Vite environment variables.
# Enter the gateway token in the companion UI for each WebView session. Phase 0
# does not issue or expire it; a trusted deployment edge can add that lifecycle.
